{
  // The Worker runs on workerd, not Node and not a browser: the only globals
  // that exist are the ES library and Cloudflare's runtime types. Pulling in
  // "dom" here would let `document` typecheck and then fail in production.
  // The dashboard's React code under src/ is the opposite tradeoff and gets
  // its own project: tsconfig.app.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // vite.config.ts and vitest.config.ts are deliberately absent: they are Node
  // scripts that vite and vitest transpile themselves, and checking them here
  // under workerd's types made `node:url` and `import.meta.url` errors — which
  // is why this script had never passed.
  "include": ["worker", "test"]
}
